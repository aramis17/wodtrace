# Supabase / Postgres
# Runtime (pooled) connection for the app
DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:6543/postgres?pgbouncer=true"
# Direct connection for migrations
DIRECT_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"

# Guest session signing secret (min 32 chars)
GUEST_SESSION_SECRET="change-me-to-a-long-random-string-at-least-32"

# Supabase project URL (Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
# Supabase Auth (accounts, boxes and coaches). Without it the app stays guest-only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# "true" only if the Magic Link email template includes {{ .Token }} (6-digit code entry)
AUTH_EMAIL_CODE="false"
# Public origin used in login emails (defaults to the request host)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# IANA zone that defines "today" for programming (defaults to the server's zone)
APP_TIME_ZONE="America/Mexico_City"

# Supabase Storage (optional — photos fall back to local public/uploads)
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="result-photos"
